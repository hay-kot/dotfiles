DOTFILES_DIR=$HOME/code/repos/dotfiles/
MMDOT_CONFIG_PATH=$HOME/code/repos/dotfiles/mmdot.yml
OBSIDIAN_NOTEBOOK_DIR="$HOME/Code/notebooks/grafana/Grafana"
OBSIDIAN_HOW_TO_DIR="$HOME/Code/notebooks/grafana/Grafana/How To Guides"

SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Let mise resolve GitHub API auth from the GitHub CLI without exporting a token.
MISE_GITHUB_CREDENTIAL_COMMAND="gh auth token -h github.com"

# Default hive agent for this machine
export HIVE_DEFAULT_AGENT=pi

# Grafana Agent observability (agento11y) for coding agents.
# The connection lives in 1Password; only the pointer is checked in, because
# this repo is public. Unset this and the claude/pi shims run the agents bare.
AGENTO11Y_OP_ITEM=Private/agento11y
AGENTO11Y_TAGS=machine=grafana
