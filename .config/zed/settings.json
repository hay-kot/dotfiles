{
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "sort_by_path": true
  },
  "agent_ui_font_size": 18.0,
  "ui_font_size": 18.0,
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_sign_in": true
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "One Dark"
  },
  "vim_mode": true
}
